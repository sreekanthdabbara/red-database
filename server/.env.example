# Copy to server/.env for local development. Never commit the real .env.
PORT=3001

# Local MySQL (on Railway the MYSQL* variables from the MySQL service are used instead)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=red_database

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Optional: only needed if the React site is hosted on a different domain than the API
# CLIENT_URL=https://your-site.example.com
